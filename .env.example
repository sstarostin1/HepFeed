# ============================================================
# HepFeed — переменные окружения
# Скопируйте этот файл в .env и заполните значения.
# Файл .env НИКОГДА не коммитится в репозиторий (см. .gitignore).
# ============================================================

# --- LLM-провайдер (генерация заметок, веб-поиск) ---
POLZA_API_KEY=
# OpenAI-совместимый эндпоинт, основная модель и фолбэки (через запятую,
# в порядке убывания приоритета)
LLM_BASE_URL=https://polza.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-flash-0731@provider=open-inference/fp8
LLM_MODEL_FALLBACKS=deepseek/deepseek-v4-flash-0731@provider=streamlake/fp8,deepseek/deepseek-v4-flash-0731@provider=deepinfra/fp8

# --- Telegram ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Канал(ы) публикации: @username или числовой ID (-100...)
TELEGRAM_CHANNEL_HEP=
TELEGRAM_CHANNEL_AP=
# Личный чат оператора для режима модерации
TELEGRAM_MODERATOR_CHAT_ID=

# --- Хранилище состояния ---
# SQLite по умолчанию; для PostgreSQL — полная строка подключения
DATABASE_URL=sqlite:///data/hepfeed.db

# --- Планировщик arXiv-опроса ---
# Интервал опроса в минутах (CONCEPT §8: цель задержки <= 12 часов)
ARXIV_POLL_INTERVAL_MINUTES=360
# Окно свежести публикаций в часах
ARXIV_POLL_WINDOW_HOURS=24
# Категории arXiv через запятую
ARXIV_CATEGORIES=hep-ex,hep-ph,physics.acc-ph
# Интервал генерации заметок в минутах
NOTES_INTERVAL_MINUTES=15
# Интервал публикации готовых заметок в минутах
PUBLISH_INTERVAL_MINUTES=10
# true — готовые заметки сначала уходят оператору на модерацию
# (решение: python -m hepfeed publish --approve ID / --reject ID)
PUBLISH_MODERATION=false

# --- Опционально ---
# Прокси для исходящих запросов к API
# HTTPS_PROXY=
# Уровень логирования (DEBUG|INFO|WARNING|ERROR)
# LOG_LEVEL=INFO
